{"contract_version":"memorist-openwebui-filter-contract-v1","memorist_version":"0.2.0-beta.2","target_openwebui_image":"ghcr.io/open-webui/open-webui:v0.9.6@sha256:90eae5b419e40b4c3dd684582b2c83440b36f9ae2f6532c09639b2ba4ee65158","target_openwebui_versions":["0.9.6 (pinned; certified host for the derivative Memorist image and auto-provisioned filter)"],"entrypoints":["inlet","outlet","valves"],"fail_open_required":true,"certification":{"contract_fixtures":"automated","container_smoke":"automated (PR5-G composed-artifact E2E; filter auto-provisioned at startup, no manual install)","model_control_plane":"automated","real_host_route_integration":"automated (pytest against the imported open_webui application)","full_version_matrix":"not_claimed_for_beta"},"notes":["The managed chat filter is upserted into Open WebUI's Functions table at every startup by memorist.backend.filter_provisioning; manual Filter installation is not part of the product.","Hosts other than the pinned version fail closed at startup unless MEMORIST_ALLOW_OPENWEBUI_VERSION explicitly acknowledges a re-certified version."]}
