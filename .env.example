MEMORIST_ENV=development
MEMORIST_LOCAL_ONLY=true
COMPOSE_PROJECT_NAME=memorist
MEMORIST_INSTALLATION_ID=
MEMORIST_HOST=0.0.0.0
MEMORIST_CORE_HOST_PORT=8777
MEMORIST_PORT=8777
OPEN_WEBUI_PORT=3000
ENABLE_OLLAMA_API=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENWEBUI_RAG_EMBEDDING_ENGINE=openai
MEMORIST_MODE=lite
MEMORIST_RUNTIME_PROFILE=lite
MEMORIST_CANONICAL_STORE=sqlite
MEMORIST_CORE_URL=http://localhost:8777
MEMORIST_ACTOR_ASSERTION_SECRET=
MEMORIST_ACTOR_SERVICE_TOKEN=
MEMORIST_OPENWEBUI_WORKSPACE_UUID=00000000-0000-0000-0000-000000000001
MEMORIST_DB_PATH=./data/memorist.sqlite
MEMORIST_POSTGRES_DSN=
MEMORIST_POSTGRES_PASSWORD=
MEMORIST_OBJECT_STORE_PATH=./data/objects
MEMORIST_IMPORT_STAGING=./data/imports
MEMORIST_EXPORT_DIR=./data/exports
MEMORIST_GRAPH_BACKEND=disabled
MEMORIST_FALKORDB_URL=
MEMORIST_ALLOW_FULL_GRAPH_DEGRADED=false
MEMORIST_VECTOR_BACKEND=disabled
MEMORIST_HOT_SCHEDULER=disabled
MEMORIST_LOG_LEVEL=INFO
MEMORIST_ENABLE_OPENWEBUI_ADAPTER=true
MEMORIST_ENABLE_GRAPH_PROJECTION=false
MEMORIST_ENABLE_MEMORY_WORKER=false
MEMORIST_ENABLE_IMPORT_SYSTEM=false
MEMORIST_ENABLE_MEMORY_CONTEXT_ATTACHMENT=false
MEMORIST_ENABLE_ACTIVE_MEMORY_BLOCKS=false
MEMORIST_ENABLE_USER_PROFILE_PROJECTION=false
MEMORIST_ENABLE_FORGETTING_PIPELINE=false
MEMORIST_PREFLIGHT_ENABLED=true
MEMORIST_PREFLIGHT_TIMEOUT_MS=60000
MEMORIST_CAPTURE_TIMEOUT_MS=2500
MEMORIST_CONTROL_TIMEOUT_MS=15000
MEMORIST_ADMIN_TIMEOUT_MS=15000
MEMORIST_PROVIDER_TEST_TIMEOUT_MS=60000
MEMORIST_IMPORT_TIMEOUT_MS=300000
MEMORIST_PREFLIGHT_MODEL_TIMEOUT_MS=60000
MEMORIST_PROCESSING_NODE_DEFAULT_TIMEOUT_MS=120000
MEMORIST_MEMORY_EXTRACTION_TIMEOUT_MS=120000
MEMORIST_HIGH_CONFIDENCE_EXTRACTION_TIMEOUT_MS=120000
MEMORIST_PRIVACY_SENSITIVITY_TIMEOUT_MS=120000
MEMORIST_BLOCK_COMPACTION_TIMEOUT_MS=120000
MEMORIST_IMPORT_RECONSTRUCTION_TIMEOUT_MS=120000
MEMORIST_EMBEDDING_TIMEOUT_MS=120000
MEMORIST_PROCESSING_CONTEXT_LIMIT_TOKENS=100000
MEMORIST_PROCESSING_MAX_INPUT_TOKENS=100000
MEMORIST_PREFLIGHT_MAX_OUTPUT_TOKENS=4096
MEMORIST_MEMORY_EXTRACTION_MAX_OUTPUT_TOKENS=16384
MEMORIST_CONSOLIDATION_MAX_OUTPUT_TOKENS=8192
MEMORIST_PRIVACY_MAX_OUTPUT_TOKENS=4096
MEMORIST_BLOCK_COMPACTION_MAX_OUTPUT_TOKENS=8192
MEMORIST_EMBEDDING_MAX_INPUT_TOKENS=100000
MEMORIST_EMBEDDING_MAX_BATCH_TOKENS=100000
MEMORIST_PREFLIGHT_FAIL_OPEN=true
MEMORIST_RETRIEVAL_MODE=standard
MEMORIST_ATTACHMENT_TOKEN_BUDGET=1800
MEMORIST_ATTACHMENT_MAX_TOKENS=1800
MEMORIST_ATTACHMENT_CONTEXT_RATIO=0.10
MEMORIST_ATTACHMENT_MIN_TOKENS=256
MEMORIST_ATTACHMENT_RESERVED_COMPLETION_TOKENS=1024
MEMORIST_ATTACHMENT_FALLBACK_CONTEXT_WINDOW=8192
MEMORIST_UNKNOWN_MODEL_CONTEXT_WINDOW=8192
MEMORIST_ATTACHMENT_SAFETY_MARGIN_TOKENS=256
MEMORIST_IMPORT_BATCH_SIZE=100
MEMORIST_IMPORT_BATCH_MAX_MS=250
MEMORIST_SCHEDULER_MAX_CONSECUTIVE_LOW_PRIORITY=1
MEMORIST_HOT_LANE_TARGET_WAIT_MS=100
MEMORIST_PREFLIGHT_PERSIST_MAX_WAIT_MS=250
MEMORIST_IMPORT_MAX_JOBS_PER_MINUTE=60
MEMORIST_IMPORT_MAX_WRITE_QUEUE_DEPTH=500
MEMORIST_IMPORT_LOW_PRIORITY=true
MEMORIST_IMPORT_RECONSTRUCTION_DEFAULT=off
MEMORIST_FAIL_OPEN=true
MEMORIST_ENABLED=true
MEMORIST_DEBUG=false

# Open WebUI session secret (installer generates a strong value locally).
WEBUI_SECRET_KEY=

# Optional provider API keys for PR5-C memory-node roles. Blank = local
# deterministic fallback. Reference the variable NAME (not the value) in the
# Memory Setup UI. Values stay local; never returned to the browser or DB.
MEMORIST_PREFLIGHT_API_KEY=
MEMORIST_MEMORY_EXTRACTION_API_KEY=
MEMORIST_HIGH_CONFIDENCE_EXTRACTION_API_KEY=
MEMORIST_EMBEDDING_API_KEY=
MEMORIST_PRIVACY_SENSITIVITY_API_KEY=
MEMORIST_BLOCK_COMPACTION_API_KEY=
MEMORIST_IMPORT_RECONSTRUCTION_API_KEY=
